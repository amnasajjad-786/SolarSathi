# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models tried in order when one hits its free quota
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.7-flash

# WhatsApp alerts (WhatsApp Business Cloud API, Meta) — users only enter their number
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with one {{1}} body parameter; "hello_world" works in test mode
WHATSAPP_TEMPLATE=hello_world
